<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReservationController"
      spacing="14" style="-fx-padding: 20;">
    <Label text="Rental reservation" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Customer" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="customerCombo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>


        <Label text="Vehicle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="vehicleCombo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>


        <Label text="Start date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>


        <Label text="End date" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="endDatePicker" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>


        <Label text="Modality" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="modalityCombo" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>


        <Label text="Payment token" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="paymentTokenField" promptText="tok_approved" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Create reservation" onAction="#onCreateReservation"/>
    <Label fx:id="resultLabel" wrapText="true"/>
</VBox>